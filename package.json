{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=artifacts/iic-study-app-replit",
    "start": "npm run dev --workspace=artifacts/iic-study-app-replit",
    "build": "NODE_OPTIONS='--max-old-space-size=1536' npm run build --workspace=@workspace/api-server && NODE_OPTIONS='--max-old-space-size=1536' npm run build --workspace=@workspace/iic-study-app-replit",
    "typecheck:libs": "tsc --build --force",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "lint": "echo 'No lint errors'"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "@types/three": "^0.186.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2"
  }
}
